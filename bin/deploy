#!/usr/bin/env bash
# Build the current HEAD as two linux/amd64 images — `syrus` (web pod,
# Dockerfile target=app) and `syrus-worker-dev` (worker pod, target=
# worker-dev with mise + multi-language tooling) — push both to GHCR
# with :<sha> and :latest tags, and rollout-restart staging +
# production K3s deployments. Uses a shared registry-backed buildx
# cache so the runtime-cache stage's compiled Rubies persist across
# builders. Reads the GHCR token from $GHCR_TOKEN or
# ~/.config/syrus/ghcr-token (chmod 600). Never prints it.
#
# Usage:
#   bin/deploy                      # both clusters (default)
#   bin/deploy --staging             # staging only
#   bin/deploy --production          # production only
#   bin/deploy --skip-build           # assume both :<sha> already pushed
#                                       (just rollout restart)
set -euo pipefail

REGISTRY="ghcr.io/tkadauke/syrus"
WORKER_DEV_REGISTRY="ghcr.io/tkadauke/syrus-worker-dev"
# Shared cache ref. `mode=max` writes ALL stage layers to this tag, so
# subsequent builds (even on fresh runners) pull pre-compiled Ruby/
# Python from the runtime-cache stage instead of recompiling.
CACHE_REF="${REGISTRY}:cache"
GHCR_USER="tkadauke"
TOKEN_FILE="${HOME}/.config/syrus/ghcr-token"

# Where each cluster's kubeconfig lives. Staging uses the default
# context (whatever kubectl points at out of the box); production
# uses an explicit file. Keeps the two clusters from racing each
# other through context switches.
STAGING_KUBECONFIG="${KUBECONFIG:-$HOME/.kube/config}"
PRODUCTION_KUBECONFIG="$HOME/.kube/config-production"

NAMESPACE_STAGING="syrus-staging"
NAMESPACE_PRODUCTION="syrus-production"
DEPLOYMENTS=(deployment/syrus-web deployment/syrus-worker)

# --- argv parsing ----------------------------------------------------
DEPLOY_STAGING=true
DEPLOY_PRODUCTION=true
SKIP_BUILD=false
while [ $# -gt 0 ]; do
  case "$1" in
    --staging)        DEPLOY_PRODUCTION=false ;;
    --production)     DEPLOY_STAGING=false ;;
    --skip-build)     SKIP_BUILD=true ;;
    -h|--help)
      sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done

cd "$(git rev-parse --show-toplevel)"

# --- preflight: clean tree, sane HEAD --------------------------------
if ! git diff-index --quiet HEAD --; then
  echo "✗ uncommitted changes — commit or stash first" >&2
  exit 1
fi
SHA="$(git rev-parse --short HEAD)"
BRANCH="$(git rev-parse --abbrev-ref HEAD)"
echo "→ deploying ${SHA} (branch ${BRANCH})"

# --- auth ------------------------------------------------------------
if [ -z "${GHCR_TOKEN:-}" ] && [ -r "$TOKEN_FILE" ]; then
  GHCR_TOKEN="$(cat "$TOKEN_FILE")"
fi
if [ -z "${GHCR_TOKEN:-}" ]; then
  cat >&2 <<MSG
✗ no GHCR token found.

  set the env var:
    export GHCR_TOKEN=ghp_xxx

  or save it to a file (and chmod 600):
    mkdir -p $(dirname "$TOKEN_FILE")
    echo ghp_xxx > $TOKEN_FILE
    chmod 600 $TOKEN_FILE

  the token needs write:packages scope.
MSG
  exit 1
fi

# --- build + push ----------------------------------------------------
# Two images, one Dockerfile: `app` (web pod) and `worker-dev` (worker
# pod, with mise + multi-language tooling so the in-pod claude-code
# agent can verify its changes — Dockerfile target).
#
# Cache: --cache-to writes max-mode (all stage layers including the
# runtime-cache stage with its compiled Rubies) to ${CACHE_REF}. The
# worker-dev build runs LAST so its cache push captures everything;
# `mode=max` index references survive across rebuilds and let fresh
# CI runners pull pre-compiled runtimes instead of recompiling.
# `verify_pushed` confirms a `<repo>:<tag>` manifest is actually
# present in GHCR after a build. `docker buildx build --push` has
# been seen to "succeed" without producing a manifest at the tag
# (transient registry hiccup, buildx driver edge case, etc.); the
# only reliable signal is asking the registry directly. Without
# this, the deploy script reports success and the next rollout
# either reuses the old :latest digest (silent regression — what
# bit us today) or kubelet ImagePullBackOffs on the SHA tag.
verify_pushed() {
  local repo="$1" tag="$2"
  local b64; b64=$(printf '%s' "$GHCR_TOKEN" | base64)
  local code
  code=$(curl -sS -o /dev/null -w '%{http_code}' \
           -H "Authorization: Bearer ${b64}" \
           -H "Accept: application/vnd.oci.image.index.v1+json" \
           -H "Accept: application/vnd.oci.image.manifest.v1+json" \
           -H "Accept: application/vnd.docker.distribution.manifest.v2+json" \
           -H "Accept: application/vnd.docker.distribution.manifest.list.v2+json" \
           "https://ghcr.io/v2/${repo#ghcr.io/}/manifests/${tag}")
  if [ "$code" != "200" ]; then
    echo "✗ ${repo}:${tag} not in registry (HTTP ${code}) — buildx --push didn't actually push" >&2
    return 1
  fi
}

if [ "$SKIP_BUILD" = false ]; then
  echo "→ ${REGISTRY} login"
  printf '%s' "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin >/dev/null

  docker buildx use colima >/dev/null 2>&1 || true

  echo "→ ${REGISTRY}:${SHA} build+push (linux/amd64, target=app)"
  docker buildx build \
    --platform linux/amd64 \
    --target app \
    --build-arg "GIT_SHA=${SHA}" \
    --cache-from "type=registry,ref=${CACHE_REF}" \
    --cache-to "type=registry,ref=${CACHE_REF},mode=max" \
    -t "${REGISTRY}:${SHA}" \
    -t "${REGISTRY}:latest" \
    --push \
    .
  verify_pushed "${REGISTRY}" "${SHA}"
  verify_pushed "${REGISTRY}" "latest"

  echo "→ ${WORKER_DEV_REGISTRY}:${SHA} build+push (linux/amd64, target=worker-dev)"
  docker buildx build \
    --platform linux/amd64 \
    --target worker-dev \
    --build-arg "GIT_SHA=${SHA}" \
    --cache-from "type=registry,ref=${CACHE_REF}" \
    --cache-to "type=registry,ref=${CACHE_REF},mode=max" \
    -t "${WORKER_DEV_REGISTRY}:${SHA}" \
    -t "${WORKER_DEV_REGISTRY}:latest" \
    --push \
    .
  verify_pushed "${WORKER_DEV_REGISTRY}" "${SHA}"
  verify_pushed "${WORKER_DEV_REGISTRY}" "latest"
else
  echo "→ skipping build/push (--skip-build); verifying existing tags in registry"
  verify_pushed "${REGISTRY}"            "${SHA}"
  verify_pushed "${WORKER_DEV_REGISTRY}" "${SHA}"
fi

# --- rollout helpers -------------------------------------------------
# Must exceed the worker's terminationGracePeriodSeconds (600s in
# the K8s manifests) plus headroom for the new pod's startup. With
# a long RunJob in flight, the old worker can drain for the full
# grace period before the new pod becomes ready. 15m gives us ~5m
# of headroom.
ROLLOUT_TIMEOUT="${ROLLOUT_TIMEOUT:-15m}"

rollout() {
  local label="$1" kubeconfig="$2" namespace="$3"
  flux_kustomization_window "$kubeconfig" suspend "$label"
  trap "flux_kustomization_window '$kubeconfig' resume '$label' || true" EXIT INT TERM
  echo "→ ${label}: rollout restart in ${namespace}"
  KUBECONFIG="$kubeconfig" kubectl rollout restart -n "$namespace" "${DEPLOYMENTS[@]}"
  for dep in "${DEPLOYMENTS[@]}"; do
    KUBECONFIG="$kubeconfig" kubectl rollout status -n "$namespace" "$dep" --timeout="$ROLLOUT_TIMEOUT"
  done
  verify_sha "$label" "$kubeconfig" "$namespace"
  flux_kustomization_window "$kubeconfig" resume "$label"
  trap - EXIT INT TERM
  echo "✓ ${label} rolled to ${SHA}"
}

# Flux's apps Kustomization reconciles every 10min and re-applies
# the manifest from Git. That re-apply strips annotations not in
# source — including the `kubectl.kubernetes.io/restartedAt` one
# `kubectl rollout restart` adds. If Flux fires mid-rollout, the
# new ReplicaSet's pod template hash collapses back to the old
# one and K8s stops replacing pods — which is exactly what bit
# us today: 2 web replicas, only 1 got rotated, the second
# stayed on the old image for hours. Suspending the Kustomization
# for the duration of the rollout keeps Flux out of the way.
# Tolerate failures (e.g. cluster without Flux installed) — log
# and continue rather than block the deploy.
FLUX_NAMESPACE="${FLUX_NAMESPACE:-flux-system}"
FLUX_KUSTOMIZATION="${FLUX_KUSTOMIZATION:-apps}"
flux_kustomization_window() {
  local kubeconfig="$1" mode="$2" label="$3"
  local suspend_value
  case "$mode" in
    suspend) suspend_value=true  ;;
    resume)  suspend_value=false ;;
    *) echo "flux_kustomization_window: unknown mode $mode" >&2; return 1 ;;
  esac
  if ! KUBECONFIG="$kubeconfig" kubectl -n "$FLUX_NAMESPACE" \
         get kustomization "$FLUX_KUSTOMIZATION" >/dev/null 2>&1; then
    echo "→ ${label}: flux kustomization '${FLUX_KUSTOMIZATION}' not found in '${FLUX_NAMESPACE}' — proceeding without suspend"
    return 0
  fi
  echo "→ ${label}: flux ${mode} kustomization/${FLUX_KUSTOMIZATION}"
  KUBECONFIG="$kubeconfig" kubectl -n "$FLUX_NAMESPACE" \
    patch kustomization "$FLUX_KUSTOMIZATION" \
    --type merge -p "{\"spec\":{\"suspend\":${suspend_value}}}" >/dev/null
}

# `kubectl rollout status` returning 0 does NOT mean the new pods
# actually run the SHA we pushed. Two ways it lies:
#
#  (a) The "rollout-restart" annotation never made it through to a
#      new ReplicaSet — Flux's periodic kustomize re-apply strips
#      annotations not present in source, undoing the restart if
#      the timing aligns. Status sees no progress to report and
#      returns immediately. Pods stay on whatever they were.
#
#  (b) The deployment uses `image: ghcr.io/.../syrus` (no tag, so
#      :latest), with `imagePullPolicy: Always`. After a restart,
#      kubelet pulls :latest — but the old pods may already be
#      running an older :latest digest. If the new ReplicaSet's
#      pods come up Ready before kubelet realizes :latest moved,
#      status is happy.  (Less common; the image-pull check usually
#      catches this in practice.)
#
# Cross-check by reading $GIT_SHA from a running container in each
# deployment. The Dockerfile bakes GIT_SHA into both `app` and
# `worker-dev` images, so this is a reliable witness of what's
# actually running.
verify_sha() {
  local label="$1" kubeconfig="$2" namespace="$3"
  local mismatch=0
  for dep in "${DEPLOYMENTS[@]}"; do
    local container="${dep#deployment/}"
    local actual
    actual="$(KUBECONFIG="$kubeconfig" kubectl exec -n "$namespace" "$dep" -c "$container" -- printenv GIT_SHA 2>/dev/null || true)"
    actual="${actual//[$'\r\n']}"
    if [ "$actual" != "$SHA" ]; then
      echo "✗ ${label}/${dep}: pods running '${actual:-<empty>}' but expected ${SHA}" >&2
      mismatch=1
    fi
  done
  if [ "$mismatch" = 1 ]; then
    cat >&2 <<MSG

The ${label} rollout reported success but at least one deployment is
still serving an older image. Now that bin/deploy suspends Flux for
the rollout window and verifies images landed in the registry before
restart, the surviving causes are:

  - A new pod failed init (db migration crash, missing secret) and
    was kept un-Ready while old pods stayed alive. Check 'kubectl get
    pods -n ${namespace}' for Init:Error / CrashLoopBackOff.

  - The deployment manifest references the wrong image repo (e.g.
    'ghcr.io/tkadauke/syrus' for the worker pod when it should be
    'ghcr.io/tkadauke/syrus-worker-dev'). Both pods then pull
    :latest from the same repo, which won't match either build.
    Check the deployment yaml in greenacres.

  - kubelet is using a cached image digest from before the push.
    Delete the affected pod manually to force a fresh pull:
    'kubectl delete pod -n ${namespace} <pod-name>'.

MSG
    exit 1
  fi
}

# --- restart -----------------------------------------------------------
if [ "$DEPLOY_STAGING" = true ]; then
  rollout "staging" "$STAGING_KUBECONFIG" "$NAMESPACE_STAGING"
fi

if [ "$DEPLOY_PRODUCTION" = true ]; then
  rollout "production" "$PRODUCTION_KUBECONFIG" "$NAMESPACE_PRODUCTION"
fi

echo ""
echo "✓ deployed ${SHA}$([ "$DEPLOY_STAGING" = true ] && echo " · staging")$([ "$DEPLOY_PRODUCTION" = true ] && echo " · production")"
