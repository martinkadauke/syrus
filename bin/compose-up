#!/usr/bin/env bash
# Bring up the single-host Syrus stack (Docker Compose + SQLite) on this Mac.
# Idempotent: generates .env with fresh secrets on first run, (re)builds the
# image, and starts web + worker. See website docs/deployment/docker-compose.
set -euo pipefail
cd "$(dirname "$0")/.."

. ./bin/docker-image-lib

if ! command -v docker >/dev/null 2>&1; then
  echo "docker not found. Install a container runtime first (OrbStack or Colima):" >&2
  echo "  brew install orbstack   # or: brew install colima docker docker-compose && colima start" >&2
  exit 1
fi

# Daemon reachable? A stopped OrbStack/Docker Desktop or a docker context aimed
# at a missing socket fails here — catch it before the slow build.
if ! syrus_require_docker_daemon >/dev/null 2>&1; then
  echo "Docker is installed but its daemon isn't reachable. Start your runtime:" >&2
  echo "  - OrbStack/Docker Desktop: open the app   - Colima: colima start" >&2
  echo "If it is running, check 'docker context ls' points at the active runtime." >&2
  exit 1
fi

# Resolve the Compose command. OrbStack ships the `docker compose` v2 plugin;
# a plain `brew install docker` (e.g. with Colima) does not — there you also
# need `brew install docker-compose`, which provides either the plugin or the
# standalone `docker-compose` binary.
if docker compose version >/dev/null 2>&1; then
  compose() { docker compose "$@"; }
elif command -v docker-compose >/dev/null 2>&1; then
  compose() { docker-compose "$@"; }
else
  echo "Docker Compose not found. Install it:" >&2
  echo "  brew install docker-compose   # then re-run bin/compose-up" >&2
  echo "(OrbStack bundles Compose; Colima + 'brew install docker' does not.)" >&2
  exit 1
fi

syrus_disable_buildx_attestations

# 1. Generate .env with fresh secrets on first run — but refuse to mint fresh
#    encryption keys when a data volume already exists, or the existing DB (which
#    was encrypted with the old keys) becomes undecryptable.
if [ ! -f .env ] && docker volume inspect syrus_syrus-data >/dev/null 2>&1; then
  echo "Error: a data volume (syrus_syrus-data) exists but .env is missing." >&2
  echo "Restore the original .env (matching encryption keys), or wipe and restart:" >&2
  echo "  docker compose down -v && bin/compose-up   (or docker-compose ...)" >&2
  exit 1
fi
if [ ! -f .env ]; then
  echo "== Generating .env with fresh secrets =="
  gen() { openssl rand -hex "$1"; }
  sed \
    -e "s|^SECRET_KEY_BASE=.*|SECRET_KEY_BASE=$(gen 64)|" \
    -e "s|^ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=.*|ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=$(gen 32)|" \
    -e "s|^ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=.*|ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=$(gen 32)|" \
    -e "s|^ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=.*|ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=$(gen 32)|" \
    compose.env.example > .env
  echo "Wrote .env (gitignored). Review it before going further if you like."
fi

# 2. Build the base worker image — the fat agent toolchain (Ruby/Node/Go via
#    mise, Python, build tools, db clients, claude-code). The FIRST build is
#    slow (it compiles language runtimes); later builds are cached.
echo "== Building the worker image (first build can take 20-40 min) =="
# --provenance=false keeps it a plain single-arch image (no attestation
# manifest list), which is simpler to use as a local FROM base.
syrus_docker_build_image worker-dev dev --provenance=false -t syrus-local-base:latest .

# 3. Build the local extension (EXTRA_APT_PACKAGES) and start the stack. The
#    build override turns the pull-based docker-compose.yml into a build-from-
#    source one (see docker-compose.build.yml).
echo "== Starting Syrus =="
compose -f docker-compose.yml -f docker-compose.build.yml up -d --build

port="$(grep -E '^SYRUS_PORT=' .env | cut -d= -f2)"
echo
echo "Syrus is starting at http://localhost:${port:-3000}"
echo "  logs:  docker compose logs -f web worker   (or docker-compose ...)"
echo "  stop:  docker compose down"
echo "The first signup becomes the admin."
