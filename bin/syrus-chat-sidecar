#!/usr/bin/env ruby
# Entry point for the per-chat MCP server. Spawned by the chat agent
# over stdio from the mcp.json ChatTurnJob writes.
#
# Boots full Rails so the sidecar can read/write ChatProposal rows.
# Same Bundler override as bin/syrus-mcp-sidecar: the agent process may
# inherit a target repository's BUNDLE_GEMFILE, but this binary must boot
# Syrus's own app bundle.
require "optparse"
require_relative "../lib/syrus_sidecar_bootstrap"

SyrusSidecarBootstrap.prepare_bundle!(sidecar_env_key: "SYRUS_CHAT_MCP_SIDECAR")

chat_session_id = ENV["SYRUS_CHAT_SESSION_ID"].to_s
current_message_id = ENV["SYRUS_CHAT_CURRENT_MESSAGE_ID"].to_s
tier = ENV["SYRUS_CHAT_MCP_TOOL_TIER"].to_s
OptionParser.new do |opts|
  opts.on("--tier TIER") { |value| tier = value.to_s }
end.parse!(ARGV)
tier = "essential" if tier.empty?
abort("usage: syrus-chat-sidecar [--tier essential|deferred]") unless %w[essential deferred].include?(tier)
ENV["SYRUS_CHAT_MCP_TOOL_TIER"] = tier

server_name = ENV["SYRUS_CHAT_MCP_SERVER_NAME"].to_s
server_name = tier == "deferred" ? "syrus-chat-deferred-sidecar" : "syrus-chat-sidecar" if server_name.empty?
ENV["SYRUS_CHAT_MCP_SERVER_NAME"] = server_name

SyrusSidecarBootstrap.open_chat_stderr!(
  chat_session_id: chat_session_id,
  message_id: current_message_id,
  server_name: server_name
)

begin
  require_relative "../config/environment"

  sidecar_class = tier == "deferred" ? SyrusChatMcp::DeferredSidecar : SyrusChatMcp::Sidecar
  sidecar_class.new.run
rescue Exception => e # rubocop:disable Lint/RescueException
  session_id = ENV["SYRUS_CHAT_SESSION_ID"].to_s
  session_id = "(missing)" if session_id.empty?
  warn "[#{server_name}] failed to start for chat session #{session_id}: #{e.class}: #{e.message}"
  e.backtrace&.first(12)&.each { |line| warn "[#{server_name}] #{line}" }
  raise
end
