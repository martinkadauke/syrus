module <%= module_name %>
  class Engine < ::Rails::Engine
    isolate_namespace <%= module_name %>

    initializer "<%= file_name %>.register_plugin" do
      Syrus::PluginRegistry.register(
        name:     "<%= file_name %>",
        version:  <%= module_name %>::VERSION,
        # Install-time metadata. Code, frontend modules, i18n files, and Rails
        # routes are present whenever the gem is installed and the app has
        # restarted; PluginRecord.enabled only controls runtime visibility/use.
        #
        # frontend: {
        #   routes: {
        #     "<%= file_name %>/AdminExample" => "app/frontend/routes/AdminExample.tsx"
        #   },
        #   i18n: [ "app/frontend/i18n/locales/*/<%= file_name %>.json" ]
        # },
        # routes: [
        #   { verb: "GET", path: "/admin/<%= file_name %>", controller: "spa#show" },
        #   { verb: "GET", path: "/api/v1/app/admin/<%= file_name %>", controller: "api/v1/app/admin/<%= file_name %>#show" }
        # ],
        provides: {
          # :agent_provider => <%= module_name %>::YourProvider,
          # :mcp_tool_set   => <%= module_name %>::YourToolSet,
          # :input_source   => <%= module_name %>::YourInputSource,
          # :admin_page     => <%= module_name %>::AdminPages,
        }
      )
    end
  end
end
