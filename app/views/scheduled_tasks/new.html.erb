<div class="max-w-2xl">
  <h1 class="font-bold text-2xl">New scheduled task</h1>
  <p class="text-sm text-gray-600 mt-1">
    On <span class="font-mono"><%= @repository.slug %></span>.
  </p>

  <div class="mt-6">
    <%= render "form",
          task: @task,
          form_url: repository_scheduled_tasks_path(@repository),
          submit_label: "Create",
          cancel_url: repository_path(@repository) %>
  </div>
</div>
