<div class="max-w-2xl">
  <h1 class="font-bold text-2xl">Edit scheduled task</h1>
  <p class="text-sm text-gray-600 mt-1">
    On <span class="font-mono"><%= @task.repository.slug %></span>.
  </p>

  <div class="mt-6">
    <%= render "form",
          task: @task,
          form_url: scheduled_task_mutation_path(@task),
          submit_label: "Save",
          cancel_url: scheduled_task_detail_path(@task) %>
  </div>
</div>
