<div id="<%= chat_session ? "chat_session_#{chat_session.id}_header" : "new_chat_header" %>"
     class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="font-bold text-3xl">
      <%= link_to repository.slug,
            repository_path(repository),
            class: "font-mono hover:underline" %>
    </h1>
  </div>
  <% if local_assigns.fetch(:chat_available, true) %>
    <div class="flex flex-wrap gap-2">
      <button type="button"
              class="rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium cursor-pointer"
              data-chat-layout-target="canvasToggle"
              data-action="chat-layout#toggleCanvas">
        <span data-chat-layout-target="canvasToggleLabel">Hide canvas</span>
      </button>
      <%= button_to "New chat",
            repository_chats_path(repository),
            method: :post,
            class: "rounded-md px-3 py-1.5 bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium cursor-pointer",
            form: { data: { chat_target: "newChatForm" } } %>
    </div>
  <% end %>
</div>
