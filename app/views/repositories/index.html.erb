<div class="space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="font-bold text-3xl">Repositories</h1>
    <%= link_to "Add", new_repository_path,
          class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-medium" %>
  </div>

  <% if @active_repositories.any? %>
    <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50 text-xs uppercase text-gray-500">
          <tr>
            <th class="px-4 py-2 text-left">Repository</th>
            <th class="hidden sm:table-cell px-4 py-2 text-left">Polling</th>
            <th class="hidden sm:table-cell px-4 py-2 text-left">Last poll</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 text-sm">
          <% @active_repositories.each do |repo| %>
            <tr>
              <%# Branch + trigger label moved underneath the slug as a
                  small muted line — frees the next two columns up for
                  the actions cell to actually fit on narrow viewports. %>
              <td class="px-4 py-3">
                <div class="font-mono">
                  <%= link_to repo.slug, repository_path(repo), class: "text-blue-600 underline hover:no-underline" %>
                </div>
                <div class="text-xs text-gray-500 mt-0.5">
                  <span class="font-mono"><%= repo.default_branch %></span>
                  <span class="text-gray-300 mx-1">·</span>
                  label <code class="bg-gray-100 px-1 rounded"><%= repo.trigger_label %></code>
                  <span class="text-gray-300 mx-1">·</span>
                  agent <%= repo.agent_provider.present? ? repo.agent_provider.titleize : "default" %>
                </div>
              </td>
              <td class="hidden sm:table-cell px-4 py-3">
                <% if repo.polling_enabled? %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs bg-green-100 text-green-700">enabled</span>
                <% else %>
                  <span class="inline-block px-2 py-0.5 rounded text-xs bg-gray-100 text-gray-600">paused</span>
                <% end %>
              </td>
              <td class="hidden sm:table-cell px-4 py-3 text-sm">
                <% if repo.last_poll_status == "failed" %>
                  <span class="text-red-600 font-medium">failed</span>
                  <span class="text-gray-500 text-xs"><%= relative_timestamp(repo.last_poll_started_at) %></span>
                  <div class="text-red-500 text-xs mt-0.5 font-mono truncate max-w-xs" title="<%= h repo.last_poll_error %>"><%= repo.last_poll_error %></div>
                <% elsif repo.last_poll_status == "ok" %>
                  <span class="text-green-700">ok</span>
                  <span class="text-gray-500 text-xs"><%= relative_timestamp(repo.last_poll_started_at) %></span>
                <% else %>
                  <span class="text-gray-400">—</span>
                <% end %>
              </td>
              <%# Stack-on-mobile / row-on-desktop so the action cluster
                  doesn't clip off the right edge on narrow viewports. %>
              <td class="px-4 py-3 text-right">
                <div class="flex flex-col items-end gap-1 sm:flex-row sm:gap-3">
                  <%= button_to "Poll now", poll_repository_path(repo), method: :post,
                        class: "text-blue-600 underline hover:no-underline cursor-pointer",
                        form: { class: "inline" } %>
                  <%= link_to "Edit", edit_repository_path(repo), class: "text-blue-600 underline hover:no-underline" %>
                  <%= button_to "Archive", archive_repository_path(repo), method: :post,
                        class: "text-amber-700 underline hover:no-underline cursor-pointer",
                        form: { class: "inline", data: { turbo_confirm: "Archive #{repo.slug}? Polling stops; existing jobs are unaffected." } } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-600">
      No active repositories. Add one to start polling for issues labelled <code class="bg-gray-100 px-1 rounded">syrus</code>.
    </div>
  <% end %>

  <% if @archived_repositories.any? %>
    <div class="space-y-2">
      <h2 class="text-sm font-medium text-gray-500 uppercase tracking-wide">Archived (<%= @archived_repositories.size %>)</h2>
      <div class="bg-white border border-gray-200 rounded-lg overflow-hidden opacity-75">
        <table class="min-w-full divide-y divide-gray-200">
          <tbody class="divide-y divide-gray-100 text-sm">
            <% @archived_repositories.each do |repo| %>
              <tr>
                <td class="px-4 py-3 text-gray-500">
                  <div class="font-mono"><%= repo.slug %></div>
                  <div class="text-xs text-gray-400 mt-0.5">archived <%= relative_timestamp(repo.archived_at) %></div>
                </td>
                <%# Actions stack vertically on mobile (otherwise they
                    clip off the right edge on narrow viewports), and
                    return to a horizontal row at the `sm` breakpoint
                    where the table has room. %>
                <td class="px-4 py-3 text-right">
                  <%= button_to "Unarchive", unarchive_repository_path(repo), method: :post,
                        class: "text-blue-600 underline hover:no-underline cursor-pointer",
                        form: { class: "inline" } %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>
