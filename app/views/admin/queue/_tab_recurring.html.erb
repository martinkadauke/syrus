<%# Recurring tasks defined in config/recurring.yml. last_run_at
    > expected interval × 2 = the recurring scheduler is starved
    or the task itself is failing on every tick. %>
<% if @recurring.any? %>
  <div class="bg-white border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50 text-xs uppercase text-gray-500">
        <tr>
          <th class="px-4 py-2 text-left">Key</th>
          <th class="px-4 py-2 text-left">Class</th>
          <th class="px-4 py-2 text-left">Schedule</th>
          <th class="px-4 py-2 text-left">Last run</th>
          <th class="px-4 py-2 text-left">Last finished</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @recurring.each do |row| %>
          <tr>
            <td class="px-4 py-2 font-mono text-xs"><%= row[:key] %></td>
            <td class="px-4 py-2 font-mono text-xs"><%= row[:class_name] %></td>
            <td class="px-4 py-2 font-mono text-xs text-gray-600"><%= row[:schedule] %></td>
            <td class="px-4 py-2 text-xs text-gray-600"><%= relative_timestamp(row[:last_run_at]) %></td>
            <td class="px-4 py-2 text-xs text-gray-600">
              <% if row[:last_finished_at] %>
                <%= relative_timestamp(row[:last_finished_at]) %>
              <% elsif row[:last_run_at] %>
                <span class="text-amber-700 italic">never finished (still running or stuck)</span>
              <% else %>
                <span class="text-gray-400">—</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-500">
    No recurring tasks registered.
  </div>
<% end %>
