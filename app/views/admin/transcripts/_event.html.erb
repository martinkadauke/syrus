<%# One transcript event. Renders different shells per kind so the
    visual hierarchy reads at a glance: assistant text in light
    cards, tool calls in tighter blocks with the tool name as a
    badge, results truncated with click-to-expand. %>
<% case event.kind
   when :system_init %>
  <details open class="bg-gray-50 border border-gray-200 rounded-md text-xs">
    <summary class="px-3 py-2 cursor-pointer flex items-center gap-2 select-none">
      <span class="px-1.5 py-0.5 rounded bg-gray-200 text-gray-700 font-mono uppercase">init</span>
      <span class="text-gray-700"><%= event.data[:model] %></span>
      <span class="text-gray-400">·</span>
      <span class="text-gray-500 font-mono"><%= event.data[:cwd] %></span>
    </summary>
    <pre class="px-3 pb-3 font-mono text-gray-600 overflow-x-auto"><%= JSON.pretty_generate(event.data) %></pre>
  </details>

<% when :user_prompt %>
  <div class="bg-blue-50 border border-blue-100 rounded-md px-3 py-2">
    <div class="text-xs uppercase text-blue-700 font-medium mb-1">user prompt</div>
    <pre class="text-sm text-gray-800 whitespace-pre-wrap break-words font-mono"><%= event.data[:text] %></pre>
  </div>

<% when :assistant_text %>
  <div class="bg-white border border-gray-200 rounded-md px-3 py-2">
    <div class="text-xs uppercase text-gray-500 mb-1">assistant</div>
    <pre class="text-sm text-gray-800 whitespace-pre-wrap break-words"><%= event.data[:text] %></pre>
  </div>

<% when :tool_use %>
  <% mcp = event.data[:name].to_s.start_with?("mcp__") %>
  <details class="bg-white border border-gray-200 rounded-md text-xs">
    <summary class="px-3 py-2 cursor-pointer flex items-center gap-2 select-none">
      <span class="<%= mcp ? "bg-fuchsia-100 text-fuchsia-700" : "bg-amber-100 text-amber-700" %> px-1.5 py-0.5 rounded font-mono uppercase">tool</span>
      <span class="font-mono text-gray-800"><%= event.data[:name] %></span>
      <% if event.data[:input].is_a?(Hash) && (cmd = event.data[:input]["command"] || event.data[:input]["file_path"] || event.data[:input]["pattern"] || event.data[:input]["query"]) %>
        <span class="text-gray-500 truncate"><%= cmd.to_s[0, 200] %></span>
      <% end %>
    </summary>
    <pre class="px-3 pb-3 font-mono text-gray-600 overflow-x-auto"><%= JSON.pretty_generate(event.data[:input]) %></pre>
  </details>

<% when :tool_result %>
  <details class="bg-gray-50 border border-gray-100 rounded-md text-xs">
    <summary class="px-3 py-2 cursor-pointer flex items-center gap-2 select-none">
      <span class="<%= event.data[:error] ? "bg-red-100 text-red-700" : "bg-emerald-100 text-emerald-700" %> px-1.5 py-0.5 rounded font-mono uppercase">
        <%= event.data[:error] ? "tool err" : "tool ok" %>
      </span>
      <% preview = event.data[:content].to_s.gsub(/\s+/, " ")[0, 150] %>
      <span class="text-gray-500 truncate"><%= preview %></span>
    </summary>
    <pre class="px-3 pb-3 font-mono text-gray-600 overflow-x-auto whitespace-pre-wrap break-words"><%= event.data[:content].is_a?(String) ? event.data[:content] : JSON.pretty_generate(event.data[:content]) %></pre>
  </details>

<% when :result %>
  <% errored = event.data[:is_error] %>
  <div class="<%= errored ? "bg-red-50 border-red-200" : "bg-emerald-50 border-emerald-200" %> border rounded-md px-3 py-2 text-xs">
    <div class="flex items-center gap-3 font-mono">
      <span class="<%= errored ? "text-red-700" : "text-emerald-700" %> uppercase font-semibold">result</span>
      <span class="text-gray-700">turns=<%= event.data[:turns] %></span>
      <span class="text-gray-700">duration=<%= event.data[:duration_ms] %>ms</span>
      <% if event.data[:cost_usd] %>
        <span class="text-gray-700">cost=$<%= format('%.4f', event.data[:cost_usd]) %></span>
      <% end %>
      <span class="text-gray-700">subtype=<%= event.data[:subtype] %></span>
    </div>
    <% if event.data[:final_text].present? %>
      <pre class="mt-2 text-sm text-gray-800 whitespace-pre-wrap break-words"><%= event.data[:final_text] %></pre>
    <% end %>
  </div>

<% when :other %>
  <details class="text-xs text-gray-400">
    <summary class="cursor-pointer">other event: <span class="font-mono"><%= event.data["type"] %></span></summary>
    <pre class="font-mono overflow-x-auto"><%= event.data.to_json[0, 1000] %></pre>
  </details>
<% end %>
