<%# A single overview tile.
    Locals:
      title    — header label
      value    — large number / string in the middle
      context  — small text below value
      status   — :ok | :warn | :alarm | :info | :idle (color cue)
      link     — optional click-through path %>
<% styles = {
     ok:    "border-emerald-200 bg-emerald-50",
     warn:  "border-amber-200 bg-amber-50",
     alarm: "border-red-200 bg-red-50",
     info:  "border-blue-200 bg-blue-50",
     idle:  "border-gray-200 bg-white"
   } %>
<% value_styles = {
     ok:    "text-emerald-800",
     warn:  "text-amber-800",
     alarm: "text-red-800",
     info:  "text-blue-800",
     idle:  "text-gray-700"
   } %>
<% wrapper_class = "border rounded-lg p-4 #{styles[status] || styles[:idle]}" %>
<% link = local_assigns[:link] %>
<% if link %>
  <%= link_to link, class: "block #{wrapper_class} hover:shadow-sm transition-shadow" do %>
    <div class="text-xs uppercase text-gray-500"><%= title %></div>
    <div class="mt-1 text-2xl font-bold <%= value_styles[status] || value_styles[:idle] %>"><%= value %></div>
    <div class="mt-1 text-xs text-gray-600"><%= context %></div>
  <% end %>
<% else %>
  <div class="<%= wrapper_class %>">
    <div class="text-xs uppercase text-gray-500"><%= title %></div>
    <div class="mt-1 text-2xl font-bold <%= value_styles[status] || value_styles[:idle] %>"><%= value %></div>
    <div class="mt-1 text-xs text-gray-600"><%= context %></div>
  </div>
<% end %>
