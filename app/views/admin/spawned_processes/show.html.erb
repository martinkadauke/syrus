<div class="space-y-6">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h1 class="font-bold text-2xl">
        Process #<%= @process.id %>
        <span class="rounded px-2 py-1 text-sm font-medium align-middle ml-2 <%= kind_pill_class(@process.kind) %>"><%= @process.kind %></span>
      </h1>
      <p class="text-sm text-gray-500 mt-1 font-mono break-all"><%= @process.command %></p>
    </div>
    <%= render "admin/nav" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-sm">
    <dl class="contents">
      <dt class="text-gray-500">Hostname</dt>
      <dd class="font-mono"><%= @process.hostname %></dd>

      <dt class="text-gray-500">PID / PGID</dt>
      <dd class="font-mono"><%= @process.pid || "—" %> / <%= @process.pgid || "—" %></dd>

      <dt class="text-gray-500">Workdir</dt>
      <dd class="font-mono break-all"><%= @process.workdir || "—" %></dd>

      <dt class="text-gray-500">Started</dt>
      <dd><%= relative_timestamp(@process.started_at) %></dd>

      <dt class="text-gray-500">Last chunk</dt>
      <dd>
        <% if @process.last_chunk_at %>
          <%= relative_timestamp(@process.last_chunk_at) %>
        <% else %>
          <span class="text-gray-400">no output yet</span>
        <% end %>
        <% if @process.stale? %>
          <span class="ml-1 rounded bg-amber-200 px-1 text-amber-900 text-[0.65rem] uppercase font-semibold">stale</span>
        <% end %>
      </dd>

      <dt class="text-gray-500">Finished</dt>
      <dd>
        <% if @process.finished_at %>
          <%= relative_timestamp(@process.finished_at) %>
        <% else %>
          <span class="text-gray-400">still running</span>
        <% end %>
      </dd>

      <dt class="text-gray-500">Duration</dt>
      <dd><%= duration_label(@process.duration_s) %></dd>

      <dt class="text-gray-500">Outcome</dt>
      <dd>
        <% if @process.finished? %>
          <span class="rounded px-2 py-0.5 font-medium <%= outcome_pill_class(@process.outcome) %>"><%= @process.outcome %></span>
          <% if @process.exit_status %>
            <span class="text-gray-400 ml-1">exit <%= @process.exit_status %></span>
          <% end %>
        <% elsif @process.kill_requested? %>
          <span class="rounded bg-amber-100 text-amber-800 px-2 py-0.5 font-medium">kill requested</span>
        <% else %>
          <span class="rounded bg-blue-100 text-blue-800 px-2 py-0.5 font-medium">running</span>
        <% end %>
      </dd>

      <dt class="text-gray-500">Wall timeout</dt>
      <dd><%= duration_label(@process.wall_timeout_s) %></dd>

      <dt class="text-gray-500">Silent timeout</dt>
      <dd><%= duration_label(@process.silent_timeout_s) %></dd>

      <% if @process.run_id %>
        <dt class="text-gray-500">Run</dt>
        <dd><%= link_to "##{@process.run_id}", admin_run_transcript_path(@process.run_id), class: "text-blue-600 hover:underline" %></dd>
      <% end %>

      <% if @process.workflow_id %>
        <dt class="text-gray-500">Workflow</dt>
        <dd>#<%= @process.workflow_id %></dd>
      <% end %>

      <% if @process.kill_requested_at %>
        <dt class="text-gray-500">Kill requested</dt>
        <dd>
          <%= relative_timestamp(@process.kill_requested_at) %>
          <% if @process.kill_requested_by_user %>
            <span class="text-gray-500">by <%= @process.kill_requested_by_user.email_address %></span>
          <% end %>
        </dd>
      <% end %>
    </dl>
  </div>

  <% if @host_metrics %>
    <div class="bg-white border border-gray-200 rounded-lg p-4">
      <h2 class="text-sm font-semibold text-gray-700 mb-2">Host metrics</h2>
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-2 text-sm">
        <% @host_metrics.each do |key, value| %>
          <div>
            <dt class="text-gray-500"><%= key.to_s.humanize %></dt>
            <dd class="font-mono"><%= format_metric(key, value) %></dd>
          </div>
        <% end %>
      </dl>
      <p class="text-xs text-gray-400 mt-2">Read from /proc/<%= @process.pid %>/{status,stat}. Linux only.</p>
    </div>
  <% end %>

  <% if @process.running? && !@process.kill_requested? %>
    <%= button_to "Kill this process", admin_legacy_kill_process_path(@process), method: :post,
          data: { turbo_confirm: "Send SIGTERM (then SIGKILL after 5s) to #{@process.kind} ##{@process.id}?" },
          class: "inline-flex items-center rounded-md bg-red-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-red-700 cursor-pointer" %>
  <% end %>
</div>
