<%# Renders all of a Job's Workflows in reverse-chronological order
    (newest first), with each Workflow's chain of Steps + Runs
    inside. The latest Workflow's first un-finished Step's transcript
    is the live one — turbo morphs it on broadcast. %>
<% workflows_array = workflows.to_a %>
<% if workflows_array.empty? %>
  <div class="bg-white border border-gray-200 rounded-lg p-6 text-sm text-gray-500">
    No workflows yet.
  </div>
<% else %>
  <% workflows_array.reverse_each.with_index do |wf, idx| %>
    <%= render "workflow", workflow: wf, workflow_number: workflows_array.size - idx, job: job %>
  <% end %>
<% end %>
