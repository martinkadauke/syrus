<%# Uses the same fetch-backed picker controller as the column picker so
    it can live inside dashboard chrome without adding nested forms. %>
<div class="relative inline-flex"
     data-controller="column-picker"
     data-column-picker-endpoint="<%= dashboard_preferences_path %>"
     data-column-picker-subject="<%= subject %>"
     data-column-picker-field-name="kanban_lanes[]">
  <button type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-300 bg-white text-gray-600 shadow-sm hover:bg-gray-50"
          aria-label="Choose Kanban lanes"
          title="Choose Kanban lanes"
          data-action="column-picker#toggle">
    <svg aria-hidden="true" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M4 5h16" />
      <path d="M4 12h16" />
      <path d="M4 19h16" />
      <path d="M8 5v14" />
      <path d="M16 5v14" />
    </svg>
  </button>

  <div class="absolute right-0 z-20 mt-10 hidden max-h-96 w-56 overflow-y-auto rounded-md border border-gray-200 bg-white p-3 text-sm normal-case text-gray-700 shadow-lg"
       data-column-picker-target="panel">
    <div class="space-y-3">
      <div class="space-y-1.5">
        <% dashboard_kanban_lanes(subject).each do |lane| %>
          <label class="flex items-center gap-2 text-gray-700">
            <%= check_box_tag "kanban_lanes[]",
                  lane,
                  dashboard_kanban_lane_visible?(subject, lane),
                  id: "dashboard_#{subject}_lane_#{lane}",
                  class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
            <span><%= dashboard_kanban_lane_label(subject, lane) %></span>
          </label>
        <% end %>
      </div>

      <div class="flex justify-end border-t border-gray-100 pt-2">
        <button type="button"
                data-action="column-picker#save"
                class="rounded-md bg-gray-800 px-3 py-1.5 text-xs font-medium text-white hover:bg-gray-700 cursor-pointer">
          Done
        </button>
      </div>
    </div>
  </div>
</div>
