<%# Reusable alert banner for SystemAlerts.
    Locals:
      alert — a SystemAlerts::Alert
    The HTML rendering is severity-driven: alarm = red, warn =
    amber, info = blue. action_steps content is treated as HTML
    (so callers can embed links and <code> hints); set responsibly
    — only the alert source can write here, never user input. %>
<% palette = case alert.severity
             when :alarm then "border-red-300 bg-red-50 text-red-900"
             when :warn  then "border-amber-300 bg-amber-50 text-amber-900"
             when :info  then "border-blue-300 bg-blue-50 text-blue-900"
             else             "border-gray-300 bg-gray-50 text-gray-900"
             end %>
<% icon = case alert.severity
          when :alarm then "⛔"
          when :warn  then "⚠"
          when :info  then "ℹ"
          else "·"
          end %>
<div class="border-l-4 <%= palette %> rounded-md p-4">
  <div class="flex items-start gap-3">
    <div class="text-2xl leading-none mt-0.5"><%= icon %></div>
    <div class="flex-1">
      <h3 class="font-semibold"><%= alert.title %></h3>
      <p class="mt-1 text-sm"><%= alert.message %></p>
      <% if alert.action_steps.any? %>
        <ol class="mt-3 ml-5 list-decimal text-sm space-y-1">
          <% alert.action_steps.each do |step| %>
            <li><%= step.html_safe %></li>
          <% end %>
        </ol>
      <% end %>
    </div>
    <% if alert.cta %>
      <%= link_to alert.cta[:text], alert.cta[:path],
            class: "shrink-0 rounded-md bg-white border border-current px-3 py-1.5 text-sm font-medium hover:bg-opacity-80" %>
    <% end %>
  </div>
</div>
