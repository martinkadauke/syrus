<%# Per-user settings tabs. App-wide settings (the AppSetting model)
    live in the Admin area and are NOT linked here, even for admins —
    the per-user vs site-wide split is the value of two separate
    surfaces. Invitations stays here because it's user-initiated
    (admins invite specific people). %>
<nav class="flex gap-6 border-b border-gray-200 mb-6 pb-0 text-sm">
  <%= link_to "My credentials", edit_credentials_path,
        class: "pb-3 border-b-2 #{controller_name == 'credentials' ? 'border-blue-600 text-blue-600 font-medium' : 'border-transparent text-gray-600 hover:text-gray-900'}" %>
  <%= link_to "Templates", cron_templates_path,
        class: "pb-3 border-b-2 #{controller_name == 'cron_templates' ? 'border-blue-600 text-blue-600 font-medium' : 'border-transparent text-gray-600 hover:text-gray-900'}" %>
  <% if Current.user&.admin? %>
    <%= link_to "Invitations", invitations_path,
          class: "pb-3 border-b-2 #{controller_name == 'invitations' ? 'border-blue-600 text-blue-600 font-medium' : 'border-transparent text-gray-600 hover:text-gray-900'}" %>
  <% end %>
</nav>
