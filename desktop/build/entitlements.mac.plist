<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for Electron: V8 needs JIT and
     writable-executable memory. The walkthrough recorder captures the user's
     narration, so the app needs the microphone device entitlement (with a
     matching NSMicrophoneUsageDescription in electron-builder.yml extendInfo) —
     without it, macOS hands getUserMedia a SILENT audio track and the
     recording has no narration. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
